{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/sae/camera-track.schema.json",
  "title": "CameraTrack — virtual camera moves on the base video (output time)",
  "type": "object",
  "additionalProperties": false,
  "required": ["cameraTrackVersion", "timebase", "mode", "source", "output", "maxZoom", "seed", "moves"],
  "properties": {
    "cameraTrackVersion": {"const": "1.0"},
    "timebase": {"const": "output"},
    "mode": {"type": "string"},
    "source": {"type": "object", "additionalProperties": false, "required": ["width", "height"],
               "properties": {"width": {"type": "integer", "minimum": 2}, "height": {"type": "integer", "minimum": 2}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["width", "height", "fps"],
               "properties": {"width": {"type": "integer", "minimum": 2}, "height": {"type": "integer", "minimum": 2},
                              "fps": {"type": "number", "exclusiveMinimum": 0}}},
    "maxZoom": {"type": "number", "minimum": 1, "maximum": 2},
    "seed": {"type": "integer"},
    "moves": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "startSec", "durationSec"],
        "properties": {
          "id": {"type": "string", "pattern": "^m\\d{2,}$"},
          "type": {"enum": ["smooth-zoom", "punch-in", "punch-out", "reframe-step", "pan", "shake", "hold"]},
          "startSec": {"type": "number", "minimum": 0},
          "durationSec": {"type": "number", "minimum": 0, "maximum": 10},
          "fromZoom": {"type": "number", "minimum": 1, "maximum": 2},
          "toZoom": {"type": "number", "minimum": 1, "maximum": 2},
          "fromCenter": {"$ref": "#/$defs/pt"},
          "toCenter": {"$ref": "#/$defs/pt"},
          "easing": {"enum": ["linear", "ease-in", "ease-out", "ease-in-out", "back-out", "step"]},
          "amplitude": {"type": "number", "minimum": 0, "maximum": 0.02, "description": "shake: fraction of frame; hard cap 2%"},
          "frequencyHz": {"type": "number", "minimum": 1, "maximum": 20},
          "seed": {"type": "integer"},
          "source": {"type": "string"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"pt": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}}}
}
