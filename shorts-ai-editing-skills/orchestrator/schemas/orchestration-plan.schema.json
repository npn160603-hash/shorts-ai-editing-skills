{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/sae/orchestration-plan.schema.json",
  "title": "OrchestrationPlan — which skills run, in which order, in which mode, and why",
  "type": "object",
  "additionalProperties": false,
  "required": ["planVersion", "resolvedIntent", "intensity", "effectBudget", "skills", "stages", "conflictRules", "reviewLoop", "rollback"],
  "properties": {
    "planVersion": {"const": "1.0"},
    "instruction": {"type": "string"},
    "resolvedIntent": {"type": "object", "additionalProperties": {"type": ["boolean", "string"]}},
    "intensity": {"enum": ["subtle", "normal", "dynamic"]},
    "effectBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAccentsPer10s", "minGapBetweenAccentsSec", "maxCameraMovesPer10s", "maxVisualTransitions", "maxSfxPer10s"],
      "properties": {
        "maxAccentsPer10s": {"type": "number", "minimum": 0},
        "minGapBetweenAccentsSec": {"type": "number", "minimum": 0},
        "maxCameraMovesPer10s": {"type": "number", "minimum": 0},
        "maxVisualTransitions": {"type": "integer", "minimum": 0},
        "maxSfxPer10s": {"type": "number", "minimum": 0}
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "mode", "reasons"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["planned", "fallback", "skipped", "blocked"]},
          "mode": {"type": "string"},
          "reasons": {"type": "array", "items": {"type": "string"}},
          "missingCapabilities": {"type": "array", "items": {"type": "string"}},
          "needsIntegration": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "id", "action", "inputs", "outputs"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "id": {"type": "string"},
          "skill": {"type": ["string", "null"]},
          "action": {"type": "string"},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "items": {"type": "string"}},
          "gate": {"type": "string"}
        }
      }
    },
    "conflictRules": {"type": "array", "items": {"type": "string", "pattern": "^CR-\\d{2}$"}},
    "reviewLoop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxIterations", "stopWhen"],
      "properties": {
        "maxIterations": {"type": "integer", "minimum": 0},
        "stopWhen": {"type": "string"}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["neverOverwrite", "keepRevisions", "allSkillsOffEqualsBaseline"],
      "properties": {
        "neverOverwrite": {"type": "boolean"},
        "keepRevisions": {"type": "integer", "minimum": 1},
        "allSkillsOffEqualsBaseline": {"type": "boolean"}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
