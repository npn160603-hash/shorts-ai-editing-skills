{
  "planVersion": "1.0",
  "instruction": "Edit video này theo phong cách Shorts chuyên nghiệp, cắt những đoạn thừa, thêm phụ đề động, zoom những đoạn quan trọng, dùng hiệu ứng vừa phải và giữ giọng nói rõ.",
  "resolvedIntent": {
    "cut": true,
    "captions": true,
    "camera": true,
    "audio": true,
    "speechPriority": true,
    "style": "professional",
    "intensity": "normal",
    "transitions": true,
    "vfx": true,
    "sfx": true,
    "music": true
  },
  "intensity": "normal",
  "effectBudget": {
    "maxAccentsPer10s": 2.5,
    "minGapBetweenAccentsSec": 1.6,
    "maxCameraMovesPer10s": 2.0,
    "maxVisualTransitions": 2,
    "maxSfxPer10s": 2.0
  },
  "skills": [
    {
      "id": "ai-editing-orchestrator",
      "status": "planned",
      "mode": "default",
      "reasons": [
        "requested and supported"
      ]
    },
    {
      "id": "smart-cut-pacing",
      "status": "planned",
      "mode": "silence-signal+word-gaps",
      "reasons": [
        "requested and supported"
      ]
    },
    {
      "id": "editing-director",
      "status": "planned",
      "mode": "heuristic",
      "reasons": [
        "requested and supported"
      ]
    },
    {
      "id": "smart-captions",
      "status": "planned",
      "mode": "word-highlight;ass;safe-zone",
      "reasons": [
        "requested and supported"
      ],
      "needsIntegration": [
        "overlay.motionPresets"
      ]
    },
    {
      "id": "camera-movement",
      "status": "fallback",
      "mode": "center-weighted;no-shake;integer-crop",
      "reasons": [
        "integer-pixel crop: prefer punch-in (instant) over slow push-in to avoid jitter"
      ]
    },
    {
      "id": "advanced-transitions",
      "status": "planned",
      "mode": "restrained",
      "reasons": [
        "requested and supported"
      ]
    },
    {
      "id": "cinematic-vfx",
      "status": "planned",
      "mode": "tiered:colorAdjust+blur+glow+motionBlur",
      "reasons": [
        "requested and supported"
      ]
    },
    {
      "id": "audio-director",
      "status": "planned",
      "mode": "speech-first;loudnorm+crossfade+denoise+duck+mixSfx",
      "reasons": [
        "requested and supported"
      ]
    },
    {
      "id": "shorts-motion-designer",
      "status": "planned",
      "mode": "basic-text",
      "reasons": [
        "requested and supported"
      ],
      "needsIntegration": [
        "overlay.motionPresets"
      ]
    },
    {
      "id": "visual-quality-reviewer",
      "status": "planned",
      "mode": "automated",
      "reasons": [
        "requested and supported"
      ]
    }
  ],
  "stages": [
    {
      "order": 1,
      "id": "probe",
      "skill": null,
      "action": "ffprobe source; copy source read-only; create revision folder",
      "inputs": [
        "source"
      ],
      "outputs": [
        "probe"
      ],
      "gate": "abort if no video stream or duration <= 0"
    },
    {
      "order": 2,
      "id": "transcript",
      "skill": null,
      "action": "load transcript; NFC-normalise; mark wordTimestampsReliable",
      "inputs": [
        "source"
      ],
      "outputs": [
        "transcript"
      ]
    },
    {
      "order": 3,
      "id": "cut",
      "skill": "smart-cut-pacing",
      "action": "detect silences/fillers/retakes -> cutList; remap transcript to output time",
      "inputs": [
        "probe",
        "transcript"
      ],
      "outputs": [
        "cutList",
        "transcript@output"
      ],
      "gate": "removed ratio <= constraints.maxRemovedRatio"
    },
    {
      "order": 4,
      "id": "direct",
      "skill": "editing-director",
      "action": "segment analysis -> per-segment decisions within effect budget",
      "inputs": [
        "transcript@output",
        "cutList"
      ],
      "outputs": [
        "contentAnalysis",
        "directorDecisions"
      ]
    },
    {
      "order": 5,
      "id": "captions",
      "skill": "smart-captions",
      "action": "chunk -> pages -> style/placement -> caption track (+ASS)",
      "inputs": [
        "transcript@output",
        "directorDecisions"
      ],
      "outputs": [
        "captionTrack"
      ]
    },
    {
      "order": 6,
      "id": "camera",
      "skill": "camera-movement",
      "action": "decisions -> camera keyframes, bounds-checked",
      "inputs": [
        "directorDecisions",
        "probe"
      ],
      "outputs": [
        "cameraTrack"
      ]
    },
    {
      "order": 7,
      "id": "transitions",
      "skill": "advanced-transitions",
      "action": "classify each cut boundary -> transition plan",
      "inputs": [
        "cutList",
        "cameraTrack",
        "directorDecisions"
      ],
      "outputs": [
        "transitionPlan"
      ]
    },
    {
      "order": 8,
      "id": "vfx",
      "skill": "cinematic-vfx",
      "action": "accent VFX within perf budget",
      "inputs": [
        "directorDecisions"
      ],
      "outputs": [
        "vfxPlan"
      ]
    },
    {
      "order": 9,
      "id": "audio",
      "skill": "audio-director",
      "action": "loudness, cut crossfades, optional duck/SFX",
      "inputs": [
        "cutList",
        "transitionPlan",
        "captionTrack"
      ],
      "outputs": [
        "audioMixPlan"
      ]
    },
    {
      "order": 10,
      "id": "compile-overlays",
      "skill": "shorts-motion-designer",
      "action": "captionTrack + director accents -> ShortsMotionPlan v1.0",
      "inputs": [
        "captionTrack",
        "directorDecisions"
      ],
      "outputs": [
        "motionPlan"
      ]
    },
    {
      "order": 11,
      "id": "conflict-check",
      "skill": null,
      "action": "apply CR-01..CR-10 across all sections; drop lower-priority items",
      "inputs": [
        "*"
      ],
      "outputs": [
        "resolvedSections"
      ]
    },
    {
      "order": 12,
      "id": "preview",
      "skill": null,
      "action": "render low-res preview (540x960) to new revision path",
      "inputs": [
        "resolvedSections"
      ],
      "outputs": [
        "previewVideo"
      ]
    },
    {
      "order": 13,
      "id": "qa",
      "skill": "visual-quality-reviewer",
      "action": "automated checks + contact sheet -> findings",
      "inputs": [
        "previewVideo",
        "resolvedSections"
      ],
      "outputs": [
        "qaReport"
      ],
      "gate": "no blocker findings"
    },
    {
      "order": 14,
      "id": "revise",
      "skill": null,
      "action": "route each finding.suggestedFix to its owner skill, bump revision, re-render",
      "inputs": [
        "qaReport"
      ],
      "outputs": [
        "revision+1"
      ]
    },
    {
      "order": 15,
      "id": "export",
      "skill": null,
      "action": "full-res export to new path; ffprobe verify; write report",
      "inputs": [
        "resolvedSections"
      ],
      "outputs": [
        "finalVideo",
        "report"
      ],
      "gate": "requireApprovalBeforeExport -> wait for user"
    }
  ],
  "conflictRules": [
    "CR-01",
    "CR-02",
    "CR-03",
    "CR-04",
    "CR-05",
    "CR-06",
    "CR-07",
    "CR-08",
    "CR-09",
    "CR-10"
  ],
  "reviewLoop": {
    "maxIterations": 2,
    "stopWhen": "no blocker and no major findings, or maxIterations reached (then report remaining findings)"
  },
  "rollback": {
    "neverOverwrite": true,
    "keepRevisions": 5,
    "allSkillsOffEqualsBaseline": true
  },
  "warnings": []
}
