{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/sae/skill-registry.schema.json",
  "title": "Skill registry — on/off switches, ownership and capability requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "skills"],
  "properties": {
    "registryVersion": {"const": "1.0"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "version", "enabled", "owns", "requires", "optional", "dependsOn"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "path": {"type": "string"},
          "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
          "enabled": {"type": "boolean"},
          "stage": {"type": "integer", "minimum": 0},
          "owns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "requires": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "description": "Capabilities that must be 'implemented', otherwise the skill is skipped (or its fallback used)."},
          "optional": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "dependsOn": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "needsAIModel": {"enum": ["no", "optional", "yes"]}
        }
      }
    }
  }
}
